/* index.wxss */
page {
  background-color: #f7f7f7;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 50px;
}

.form-box {
  width: 90%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
}

/* --- 头像区域样式 --- */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50%;
  margin-bottom: 20rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: relative;
  /* 去除按钮默认边框 */
  border: none;
}

/* 去除微信按钮自带的边框线 */
.avatar-wrapper::after {
  border: none;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx;
  border-radius: 50%;
}

.tip-text {
  font-size: 28rpx;
  color: #888;
}

/* --- 输入框区域样式 --- */
.input-group {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eee;
  padding: 20rpx 0;
  margin-bottom: 60rpx;
}

.label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  width: 120rpx; /* 固定标签宽度 */
}

.weui-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  padding-left: 20rpx;
}

/* --- 按钮样式 --- */
.submit-btn {
  width: 100% !important;
  border-radius: 50rpx;
}